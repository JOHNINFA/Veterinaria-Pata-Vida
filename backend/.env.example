# Desarrollo local. En producción configura estas variables en Render.
SECRET_KEY=genera-una-clave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://patavida:patavida123@localhost:5432/patavida
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_HSTS_SECONDS=3600

# Opcionales: el build crea o actualiza el administrador solo si están presentes.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Contraseña de los usuarios demo del panel veterinario (dra.laura / recepcion)
CLINICA_DEMO_PASSWORD=cambia-esta-clave
