# Copia este archivo como .env.local y ajusta los valores.

# URL de la API de Django (backend)
# Local:      http://localhost:8000/api
# Producción: https://tu-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WhatsApp de la tienda: solo dígitos, con código de país (ej. 57 = Colombia)
NEXT_PUBLIC_WHATSAPP=573001234567

# URL pública del sitio (para metadatos / OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
